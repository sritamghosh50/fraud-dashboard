{
  "rewrites": [
    {
      "source": "/oauth2/:path*",
      "destination": "http://16.16.209.84:8080/oauth2/:path*"
    },
    {
      "source": "/login/:path*",
      "destination": "http://16.16.209.84:8080/login/:path*"
    },
    {
      "source": "/api/:path*",
      "destination": "http://16.16.209.84:8080/api/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
